{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TuxBridge",
  "version": "0.1.4",
  "identifier": "app.rookerysoftware.tuxbridge",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TuxBridge",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE1NDAyRDE2MEY5MURGMzkKUldRNTM1RVBGaTFBcFZwV21uU0tSTTdRdmxkODc3Z2NnQ1JDZEcwbWtZemJqdm5iYXpXaGt4cE8K",
      "endpoints": ["https://tuxbridge.com/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "engine/": "engine/",
      "linux/": "linux/",
      "bin/": "bin/",
      "skill/": "skill/",
      "../help/": "help/",
      "../src/assistant/knowledge.md": "assistant/knowledge.md",
      "../THIRD-PARTY-NOTICES.md": "THIRD-PARTY-NOTICES.md",
      "../LICENSE": "LICENSE.txt",
      "../NOTICE": "NOTICE.txt"
    },
    "shortDescription": "Linux on Windows, made easy",
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "installerHooks": "./installer-hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp"
      }
    },
    "publisher": "Rookery Software",
    "copyright": "© 2026 Rookery Software"
  }
}
