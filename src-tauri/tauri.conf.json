{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EasyWSL",
  "version": "0.1.0",
  "identifier": "com.itsoverk1ll.easywsl",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "EasyWSL",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "engine/": "engine/",
      "linux/": "linux/"
    },
    "shortDescription": "Linux on Windows, made easy",
    "publisher": "ItsOverk1ll"
  }
}